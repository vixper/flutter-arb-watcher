{
  "name": "flutter-arb-watcher",
  "displayName": "Flutter .arb Watcher",
  "description": "Rigenera automaticamente le traduzioni ogni volta che salvi un file .arb in un progetto Flutter.",
  "version": "1.0.0",
  "icon": "icon.png",
  "author": "Vincenzo Perrone",
  "publisher": "vixper",
  "repository": "https://github.com/vixper/flutter-arb-watcher",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:arb",
    "workspaceContains:pubspec.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
        "title": "Flutter ARB Watcher",
        "properties": {
            "flutterArbWatcher.autoRun": {
                "type": "boolean",
                "default": true,
                "description": "Esegue gen-l10n automaticamente al salvataggio dei file .arb"
            }
        }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
